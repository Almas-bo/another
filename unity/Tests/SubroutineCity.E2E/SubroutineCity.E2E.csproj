<Project Sdk="Microsoft.NET.Sdk">
  <!-- Сквозная проверка клиентского кода против живого сервера. Требует запущенный scripts/run-server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../SubroutineCity/Assets/SubroutineCity/Scripts/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
